/*
 * CatWAN USB Stick - Device Tree Overlay
 * RP2040 + RFM95W (SX1276) single-radio LoRa USB stick
 *
 * Pin mapping (from schematic):
 *   SPI0: MISO=GPIO16, CS=GPIO17, SCK=GPIO18, MOSI=GPIO19
 *   Radio: RST=GPIO21, DIO0=GPIO10, DIO1=GPIO11, DIO2=GPIO12
 *   LED: GPIO25
 */

/ {
    chosen {
        zephyr,settings-partition = &storage_partition;
    };

    aliases {
        led0 = &led_0;
        lora0 = &rfm95;
    };

    leds {
        compatible = "gpio-leds";
        led_0: led0 {
            gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
            label = "LED";
        };
    };
};

&flash0 {
    partitions {
        /delete-node/ partition@100;

        code_partition: partition@100 {
            label = "code-partition";
            reg = <0x100 0x1eff00>;
            read-only;
        };

        storage_partition: partition@1f0000 {
            label = "storage";
            reg = <0x1f0000 0x10000>;
        };
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CatWAN-LoRa";
    };

    cdc_acm_uart1: cdc_acm_uart1 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CatWAN-Shell";
    };
};

&spi0 {
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-names = "default";
    cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;

    rfm95: sx1276@0 {
        compatible = "semtech,sx1276";
        reg = <0>;
        spi-max-frequency = <1000000>;
        reset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
        dio-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>,
                    <&gpio0 11 GPIO_ACTIVE_HIGH>,
                    <&gpio0 12 GPIO_ACTIVE_HIGH>;
        power-amplifier-output = "pa-boost";
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            pinmux = <SPI0_SCK_P18>, <SPI0_TX_P19>;
        };
        group2 {
            pinmux = <SPI0_RX_P16>;
            input-enable;
        };
    };
};
